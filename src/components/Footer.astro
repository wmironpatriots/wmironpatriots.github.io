---
import '../styles/global.css';

import instaImg from '../assets/instagram.png';
import youtubeImg from '../assets/youtube.png';
import githubImg from '../assets/github.png';
import chiefDelphiImg from '../assets/chiefdelphi.png';

const { blog } = Astro.props;
---

<div class="footer">
	<div class="links">
		<h3>USEFUL LINKS</h3>
		<div>
			<a href="/about">About</a>
			<a href="/about/board">Board</a>
			<a href="/events">Events</a>
			<a href="/sponsors">Sponsors</a>
			<a href="/sponsors/donation">Donation</a>
			<a href="/sponsors/expenses">Expenses</a>
			<a href="/sponsors/information">Sponsor Info</a>
			<a href="/outreach">Outreach</a>
			<a href="/robots">Robots</a>
			<a href="/contact">Contact</a>
		</div>
	</div>

	<div class="newsletter">
		<h3>NEWSLETTER</h3>
		<div>
			<p>Subscribe to our newsletter to stay updated on the latest news and events!</p>
			<form action="" method="POST">
				<input type="email" name="email" placeholder="Enter your email" required />
				<button type="submit">Subscribe Now</button>
			</form>
		</div>
	</div>

	<div class="contacts">
		<h3>CONTACT</h3>
		<span>
			Ward Melville High School
			<br/>
			380 Old Town Road
			<br/>
			East Setauket, NY 11733
		</span>
		<div>
			<a href="https://www.instagram.com/frc6423/"><img width="40" height="40" src={instaImg.src} alt="Instagram"/></a>
			<a href="https://www.youtube.com/@IronPatriotsFRC6423"><img width="40" height="40" src={youtubeImg.src} alt="YouTube"/></a>
			<a href="https://github.com/wmironpatriots"><img width="40" height="40" src={githubImg.src} alt="GitHub"/></a>
			<a href="https://www.chiefdelphi.com/t/6423-wm-iron-patriots-2026-rebuilt-build-thread/510232"><img width="40" height="40" src={chiefDelphiImg.src} alt="ChiefDelphi"/></a>
		</div>
	</div>
</div>
<span class="copyright">
	&copy; 2025-2026 Ward Melville Iron Patriots
</span>

<style>
	/* add responsiveness: wraps to column, not row when on mobile */

	@import url('https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap');
	
	.footer {
		display: flex;
		flex-direction: row;
		justify-content: space-evenly;
		align-items: top;
		flex-wrap: wrap;
		gap: 2em;
		padding-top: 3.5em;
		padding-bottom: 3.5em;
	}

	.footer h3 {
		margin-bottom: 1.25em;
	}

	.footer .links div {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.75em;
		flex-wrap: wrap;
		height: 140px;
	}

	.footer .links a {
		text-decoration: none;
	}

	.footer .newsletter form {
		display: flex;
		flex-direction: column;
		gap: 1em;
		align-items: center;
	}

	.footer .newsletter input {
		padding: 1em;
		border: none;
		border-radius: 5px;
		width: 300px;
		text-align: center;
		font-family: "Montserrat", sans-serif;
	}

	.footer .newsletter button {
		padding: 0.7em 1.5em;
		border: 2px solid #FFF;
		border-radius: 1.5em;
		background-color: #0e6a36;
		color: white;
		font-family: "Montserrat", sans-serif;
		font-size: 1em;
		cursor: pointer;
		height: 3em;
		transition: 0.3s;
	}

	.footer .newsletter button:hover {
		transform: translateY(-0.25em);
	}
	
	.footer .contacts {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1em;
	}

	.footer .contacts span {
		margin-bottom: 1em;
	}

  img {
		transition: 0.15s;
	}

	img:hover {
		cursor: pointer;
		transform: scale(1.2);
	}
</style>
