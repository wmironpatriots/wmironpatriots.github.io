---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import faviconImg from '../assets/favicon.png';

const { title, blog } = Astro.props;
---

<!-- Note: homepage will need to be structured differently from other pages most likely -->

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href={faviconImg.src} />
		<meta name="generator" content={Astro.generator} />
		<link rel="canonical" href="https://www.frc6423.org"/>
		<meta property="og:site_name" content="FRC 6423"/>
		<meta property="og:title" content="FRC 6423"/>
		<meta property="og:url" content="https://www.frc6423.org"/>
		<meta property="og:type" content="website"/>
		<meta property="og:description" content="The official website of FRC team 6423 Ward Melville Iron Patriots"/>
		<meta property="og:image" content={faviconImg.src}/>
		<meta property="og:image:width" content="1500"/>
		<meta property="og:image:height" content="1500"/>
		<meta itemprop="name" content="FRC 6423"/>
		<meta itemprop="url" content="https://www.frc6423.org"/>
		<meta itemprop="description" content="The official website of FRC team 6423 Ward Melville Iron Patriots"/>
		<meta itemprop="thumbnailUrl" content={faviconImg.src}/>
		<link rel="image_src" href={faviconImg.src} />
		<meta itemprop="image" content={faviconImg.src}/>
		<meta name="twitter:title" content="FRC 6423"/>
		<meta name="twitter:image" content={faviconImg.src}/>
		<meta name="twitter:url" content="https://www.frc6423.org"/>
		<meta name="twitter:card" content="summary"/>
		<meta name="twitter:description" content="The official website of FRC team 6423 Ward Melville Iron Patriots"/>
		<meta name="description" content="The official website of FRC team 6423 Ward Melville Iron Patriots" />
		<title>{ title } FRC 6423</title>

		<ClientRouter />
	</head>
	<body>
		<aside class="sponsor-night-banner" aria-label="Sponsor Night announcement">
			<strong>Annual Sponsor Night - Tuesday, September 22</strong>
			<span>Interested in sponsoring?</span>
			<a href="/sponsors/information">Learn more →</a>
		</aside>
		<slot />
	</body>
</html>

<style>
	.sponsor-night-banner {
		position: sticky;
		top: 0;
		z-index: 100;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.6rem;
		padding: 0.8rem 1rem;
		color: #fff;
		background: #00a359;
		box-shadow: 0 2px 8px rgb(0 0 0 / 25%);
		text-align: center;
	}

	.sponsor-night-banner a {
		color: #fff;
		font-weight: 700;
		text-underline-offset: 0.15em;
	}

	.sponsor-night-banner a:hover {
		color: #e1e3e1;
	}

	@media (max-width: 640px) {
		.sponsor-night-banner {
			flex-direction: column;
			gap: 0.25rem;
		}
	}
</style>
