---
import { getCollection } from 'astro:content';

import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import NavigationBar from '../components/NavigationBar.astro';

import '../styles/footer.css';

import libraryImg from '../assets/library.jpg';
import stemNightImg from '../assets/stemnight.jpg';
import showcaseImg from '../assets/showcase.jpg';
import kickoffImg from '../assets/kickoff.jpg';
import parentNightImg from '../assets/parentnight.jpg';

const title = "Events |";
const current = "events";
---

<Base title={title}>
	<article>
		<div class="page-collection">
			<nav>
				<NavigationBar current={current}/>
			</nav>

			<main>
				<header>
					<h1>Events</h1>
				</header>
				
        <div class="text-img-main"> <!-- change rectangles so they take up 75% of screen width - image and text are in same box -->
          <div class="event-item">
						<div class="text">
							<h2>Parents Night</h2>
							<h5>December 18th - Ward Melville High School</h5>
						</div>

						<div class="image">
							<img src={parentNightImg.src} alt="parents night"/>
						</div>
					</div>

					<div class="event-item inverted">
						<div class="text">
							<h2>Engineering Fair</h2>
							<h5>February 20th - Emma S. Clark Memorial Library</h5>
						</div>

						<div class="image">
							<img src={libraryImg.src} alt="engineering fair"/>
						</div>
					</div>

          <div class="event-item"> 
						<div class="text">
							<h2>Showcase Night</h2>
							<h5>March 3rd - Ward Melville High School</h5>
						</div>

						<div class="image">
							<img src={showcaseImg.src} alt="showcase"/>
						</div>
					</div>

					<!--
					<div style="" class="item"> 
						<div class="text">
							<h2>Parents Night</h2>
							<h5>December 18th</h5>
						</div>

						<div style="visibility: hidden;" class="image">
							<img src={parentNightImg.src} alt="library"/>
						</div>
					</div>

					<div style="" class="item">
						<div class="text">
							<h2>Engineering Fair at Emma S. Clark</h2>
							<h5>February 20th</h5>
						</div>

						<div style="visibility: hidden;" class="image">
							<img src={parentNightImg.src} alt="library"/>
						</div>
					</div>

					<div style="" class="item">
						<div class="text">
							<h2>Showcase Night</h2>
							<h5>March 3rd</h5>
						</div>

						<div style="visibility: hidden;" class="image">
							<img src={parentNightImg.src} alt="library"/>
						</div>
					</div> -->
        </div>
			</main>
		</div>
		<footer>
			<Footer />
		</footer>
	</article>
</Base>

<style>
	.text-img-main {
		padding-bottom: 1em;
	}

	.text-img-main .event-item {
		display: flex;
		flex-direction: row;
		align-self: flex-start;
		padding: 1.5em;
		gap: 5em;
		width: 75%;
		background: linear-gradient(to bottom left, #e1e3e1 0%, #a0a0a0 100%);
		box-shadow: -10px 10px #0e6a36;
		color: #000000;
	}

	.text-img-main .inverted {
		background: linear-gradient(to bottom left, #a0a0a0 0%, #e1e3e1 100%);
		box-shadow: 10px 10px #0e6a36;
		align-self: flex-end;
	}

	.text-img-main .event-item div {
		width: 50%;
	}
</style>