---
import Base from '../../layouts/Base.astro';
import Footer from '../../components/Footer.astro';
import NavigationBar from '../../components/NavigationBar.astro';

import '../../styles/footer.css';

const title = "Sponsors | Donation Method |";
const current = "sponsors";
---

<Base title={title}>
	<article>
		<div class="page-collection">
			<nav>
				<NavigationBar current={current} />
			</nav>

			<main>
				<header>
					<h1>Donation Method</h1>
				</header>

				<div class="text-img-main">
          <div class="item">
						<div class="text">
							<p>
								Any donations should be made out to Three Village STEM Enrichment Foundation, Inc., P. O. Box 214, East Setauket, NY 11733. Please indicate "Ward Melville Robotics Team" in the check memo or with an attached note for the funds to be directly allocated to the robotics team. Donations can also be made to the paypal link below. Please make sure you include a note stating that the money should be allocated to the Ward Melville Robotics Team.
							</p>
						</div>

						<div class="outer-button">
							<a class="button" href="mailto:ironpatriotswm@gmail.com">
								<div>
									Send Email
								</div>
							</a>

							<a class="button" href="https://www.paypal.com/donate/?hosted_button_id=MPYUVDAR7YCSC">
								<div>
									Send Paypal
								</div>
							</a>
						</div>
					</div>
        </div>
      </main>
    </div>
    <footer>
			<Footer />
		</footer>
	</article>
</Base>

<style>
	h2 {
		font-size: 200%;
	}

	h3 {
		margin-bottom: 0;
	}

	p {
		margin-top: 0.5em;
	}

	.title {
		font-size: 270%;
	}

	.page-collection .text-img-main .item {
		display: flex;
		flex-direction: column;
		justify-content: center;
		width: 100%;
	}

	.item div {
		width: 100%;
	}

	.item {
		margin-bottom: 3em;
	}

	.item h2 {
		margin-bottom: 0;
	}

	.outer-button {
		display: flex;
		justify-content: center;
		gap: 20px;
	}

	.button {
		text-decoration: none;
		font-size: 110%;
		padding: 0.5em;
		padding-right: 1.5em;
		padding-left: 1.5em;
		border-radius: 1.5em;
		border: 2px solid #FFF;
		color: #FFF;
		transition: 0.3s;
		height: 1.5em;
		display: flex;
		align-items: center;
	}

	.button:hover {
		color: #FFF;
		transform: translateY(-0.25em);
	}
</style>