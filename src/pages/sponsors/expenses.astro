---
import Base from '../../layouts/Base.astro';
import Footer from '../../components/Footer.astro';
import NavigationBar from '../../components/NavigationBar.astro';

import '../../styles/footer.css';

import expensesImg2526 from '../../assets/2526expenses.png';
import fundraisedImg2526 from '../../assets/2526fundraised.png';

const title = "Sponsors | Team Expenses |";
const current = "sponsors";
---

<Base title={title}>
	<article>
		<div class="page-collection">
			<nav>
				<NavigationBar current={current} />
			</nav>

			<main>
				<header>
					<h1>Team Expenses</h1>
				</header>

				<div class="main">
          <div class="expenses">
            <img src={expensesImg2526.src} alt="25-26 expenses"/>
					</div>

					<div class="fundraised">
						<img src={fundraisedImg2526.src} alt="25-26 fundraised money"/>
					</div>
        </div>
      </main>
    </div>
    <footer>
			<Footer />
		</footer>
	</article>
</Base>

<style>
	.main {
		gap: 5em;
		display: flex;
		flex-direction: column;
	}

	.main div {
		display: flex;
		justify-content: center;
		align-items: center;
	}
	img { /* up to change */
		width: 65%;
	}
</style>